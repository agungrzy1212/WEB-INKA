erDiagram
    USERS ||--o{ REGISTRATIONS : "has"
    COURSES ||--o{ REGISTRATIONS : "has"

    USERS {
        bigint id PK
        string name
        string email
        timestamp email_verified_at
        string password
        string role
        string remember_token
        timestamp created_at
        timestamp updated_at
    }

    COURSES {
        bigint id PK
        string name
        string category
        text description
        integer price
        string duration
        string image
        timestamp created_at
        timestamp updated_at
    }

    REGISTRATIONS {
        bigint id PK
        bigint user_id FK
        bigint course_id FK
        string nama_lengkap
        date tanggal_lahir
