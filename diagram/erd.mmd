        string payment_receipt_path
        string status
        text admin_notes
        string course_name
        timestamp created_at
        timestamp updated_at
    }

    NEWS {
        bigint id PK
        string title
        text content
        string image_path
        timestamp created_at
        timestamp updated_at
    }

    SITE_SETTINGS {
        bigint id PK
        string key
        text value
        timestamp created_at
        timestamp updated_at
    }

    GALLERY_IMAGES {
        bigint id PK
        string title
        string image_path
        timestamp created_at
        timestamp updated_at
    }
